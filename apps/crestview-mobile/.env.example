# Church Center org root for Crestview Baptist Church, Canton, NC (no trailing slash).
#
# REQUIRED, and deliberately left blank. The slug from the original brief,
# crestviewbaptist.churchcenter.com, is Crestview Baptist Church in Griffin, GA,
# so the app has no fallback: while this stays unset every Church Center screen
# shows a "Church Center is not set up" message instead of a WebView.
#
# Ask the church office for the Canton Planning Center organization, then:
# EXPO_PUBLIC_CHURCH_CENTER_URL=https://your-org.churchcenter.com

# Optional overrides for Home / More website links
# EXPO_PUBLIC_GIVE_URL=https://secure.myvanco.com/L-ZB2Z/home
# EXPO_PUBLIC_LIVE_URL=https://crestviewcanton.com/livestream
# EXPO_PUBLIC_STAFF_URL=https://crestviewcanton.com/our-staff
