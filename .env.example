# Forms: Formspree form ID (required for contact / prayer / visit / newsletter / serve).
# Create at https://formspree.io → New Form → recipient crestviewcanton@gmail.com
# (Sharon / church office). Copy the XXXXXXX from https://formspree.io/f/XXXXXXX
# Set the same value on Vercel for Production, Preview, and Development.
NEXT_PUBLIC_FORMSPREE_ID=

# GA4 only. Obtain a G-XXXXXXXXXX measurement ID from the church's GA4 property.
# Do not use the old Universal Analytics UA-166605328-1 tracking ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# YouTube live detection (server-only secret; configure Production in Vercel).
# YouTube Data API v3 must be enabled and key restrictions configured.
YOUTUBE_API_KEY=
