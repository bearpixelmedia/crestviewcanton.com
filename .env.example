# Forms: connect an approved Formspree form to the church office inbox.
# The public form ID may be stored in this NEXT_PUBLIC variable.
# The Formspree account must verify the destination and configure spam protection.
NEXT_PUBLIC_FORMSPREE_ID=

# GA4 only. Obtain a G-XXXXXXXXXX measurement ID from the church's GA4 property.
# Do not use the old Universal Analytics UA-166605328-1 tracking ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# YouTube live detection (server-only secret; configure Production in Vercel).
# YouTube Data API v3 must be enabled and key restrictions configured.
YOUTUBE_API_KEY=
