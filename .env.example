# Form delivery (optional). Without this, contact/visit/newsletter forms
# fall back to a prefilled mailto:crestviewcanton@gmail.com.
#
# 1. Create a free form at https://formspree.io
# 2. Point it at crestviewcanton@gmail.com (or Sharon’s preferred inbox)
# 3. Paste the form ID (the part after /f/):
NEXT_PUBLIC_FORMSPREE_ID=

# Optional override if you later switch to a Next.js API + Resend path
# (not wired yet, Formspree + mailto cover local/preview without secrets).
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=crestviewcanton@gmail.com

# YouTube live banner (home page, above the hero). Optional but recommended.
# Create a free key at https://console.cloud.google.com → YouTube Data API v3.
# Without it, the site still tries an HTML check (less reliable).
YOUTUBE_DATA_API_KEY=
